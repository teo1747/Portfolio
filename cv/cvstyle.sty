% =====================================================================
%  cvstyle.sty — shared layout for all CV variants
%  Engine: XeLaTeX (Overleaf: Menu > Compiler > XeLaTeX; latexmkrc sets it)
%  Single-column, real text, no icons-as-text: ATS-friendly.
%  Typeface: Archivo (SIL OFL), bundled in ./fonts — same family as the website.
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvstyle}[2026/10/28 CV layout]

% ---------- Page ----------
\RequirePackage[a4paper,top=10mm,bottom=12mm,left=14mm,right=14mm,footskip=6mm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{fontspec}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{ragged2e}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{needspace}
\RequirePackage[hidelinks,unicode]{hyperref}

% ---------- Fonts ----------
% -calt keeps every glyph mapped to Unicode: clean copy/paste and ATS parsing.
\setmainfont{Archivo}[
  Path           = ./fonts/,
  Extension      = .ttf,
  UprightFont    = *-Regular,
  ItalicFont     = *-Italic,
  BoldFont       = *-SemiBold,
  BoldItalicFont = *-SemiBoldItalic,
  Numbers        = {Lining},
  RawFeature     = {-calt},
]
\newfontfamily\mediumfont{Archivo}[Path=./fonts/, Extension=.ttf,
  UprightFont=*-Medium, BoldFont=*-SemiBold, ItalicFont=*-Italic, RawFeature={-calt}, Ligatures=TeX]
\newfontfamily\headfont{ArchivoSemiCondensed}[Path=./fonts/, Extension=.ttf,
  UprightFont=*-SemiBold, BoldFont=*-SemiBold, ItalicFont=*-SemiBold, RawFeature={-calt}, Ligatures=TeX]
\newfontfamily\namefont{ArchivoCondensed}[Path=./fonts/, Extension=.ttf,
  UprightFont=*-Bold, BoldFont=*-Bold, ItalicFont=*-Bold, RawFeature={-calt}, Ligatures=TeX]

% ---------- Colours ----------
\definecolor{ink}{HTML}{16201F}      % body text
\definecolor{accent}{HTML}{0B5C6B}   % deep teal: headings, links, markers
\definecolor{amber}{HTML}{B7791F}    % single highlight colour (header rule)
\definecolor{muted}{HTML}{56625F}    % dates, environment lines
\definecolor{rule}{HTML}{CCD5D3}
\color{ink}

% ---------- Base typography ----------
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{2em}
\tolerance=1500
\AtBeginDocument{\fontsize{9.1pt}{11.45pt}\selectfont\RaggedRight}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[R]{\fontsize{7.5pt}{9pt}\selectfont\color{muted}\cvfootername\enspace\thepage/\pageref{LastPage}}
\newcommand{\cvfootername}{}

% ---------- Sections: sentence case, accent marker, hairline to the margin ----------
\newcommand{\sectionfill}[1]{%
  {\color{accent}\rule[0.08em]{0.55em}{0.55em}}\hspace{0.45em}#1\hspace{0.6em}%
  {\color{rule}\leaders\hbox{\rule[0.3em]{1pt}{0.6pt}}\hfill}\kern0pt}
\titleformat{\section}
  {\headfont\fontsize{12pt}{14pt}\selectfont\color{accent}}
  {}{0pt}{\sectionfill}
\titlespacing*{\section}{0pt}{6pt}{3pt}

% ---------- Lists ----------
\setlist[itemize]{before=\RaggedRight,leftmargin=10pt,labelsep=4.5pt,topsep=1.5pt,itemsep=0.4pt,
  parsep=0pt,partopsep=0pt,label={\color{accent}\raisebox{0.42ex}{\rule{2.6pt}{2.6pt}}}}

% ---------- Header ----------
% \cvheader{Name}{Headline}{contact line 1}{contact line 2}
\newcommand{\cvheader}[4]{%
  {\color{amber}\rule{2.2cm}{2.2pt}}\par\vspace{5pt}
  {\namefont\fontsize{27pt}{29pt}\selectfont #1\par}
  \vspace{3pt}
  {\headfont\fontsize{12.5pt}{15pt}\selectfont\color{accent}#2\par}
  \vspace{5pt}
  {\fontsize{8.7pt}{11.6pt}\selectfont\color{ink}#3\par #4\par}
  \vspace{1pt}
}
\newcommand{\sep}{\enspace{\color{rule}|}\enspace}

% ---------- Experience entry ----------
% \cventry{Role}{Organisation}{Location}{Dates}
\newcommand{\cventry}[4]{%
  \Needspace{6\baselineskip}\vspace{3pt}
  {\headfont\fontsize{10.4pt}{12.6pt}\selectfont #1}\hfill{\mediumfont\color{muted}\fontsize{8.6pt}{11pt}\selectfont #4}\par
  {\mediumfont\color{accent}#2}{\color{muted}\enspace #3}\par
  \vspace{1pt}
}

% ---------- Project entry ----------
% \cvproject{Title}{Context label}{Dates}{repo or empty}
\newcommand{\cvproject}[4]{%
  \Needspace{5\baselineskip}\vspace{4pt}
  {\headfont\fontsize{9.9pt}{12pt}\selectfont #1}{\color{muted}\enspace #2}\hfill{\mediumfont\color{muted}\fontsize{8.6pt}{11pt}\selectfont #3}\par
  \ifx&#4&\else{\fontsize{8.3pt}{10.4pt}\selectfont\color{accent}\href{https://#4}{#4}\par}\fi
  \vspace{0.5pt}
}

% Sub-heading inside an experience entry (one per project)
\newcommand{\cvsub}[1]{\Needspace{4\baselineskip}\vspace{3pt}{\mediumfont\color{ink}#1}\par}

% Technical environment line (pass the label with its colon: "Environment:" / "Environnement\,:")
\newcommand{\cvenv}[2]{%
  \vspace{1.5pt}{\fontsize{8.3pt}{10.6pt}\selectfont\color{muted}{\mediumfont #1}\ #2\par}}

% ---------- Skills rows ----------
% \cvskill{Label}{content}
\newcommand{\cvskill}[2]{%
  \hangindent=3.3cm\hangafter=1
  \makebox[3.3cm][l]{\headfont\color{accent}#1}#2\par\vspace{1.6pt}}

% ---------- Education entry ----------
\newcommand{\cvedu}[4]{%
  \vspace{3pt}
  {\headfont\fontsize{10pt}{12.4pt}\selectfont #1}\hfill{\mediumfont\color{muted}\fontsize{8.6pt}{11pt}\selectfont #4}\par
  {\mediumfont\color{accent}#2}{\color{muted}\enspace #3}\par
}

% ---------- Variant switch ----------
% In a main file: \hwvarianttrue  -> Embedded Software & Hardware CV
%                 \hwvariantfalse -> Embedded Software CV
%                 \hwvarianttrue\fpgavarianttrue -> FPGA / SoC CV (hardware text applies too)
\newif\ifhwvariant
\newif\iffpgavariant
\newcommand{\HW}[1]{\ifhwvariant#1\fi}
\newcommand{\SW}[1]{\ifhwvariant\else#1\fi}
\newcommand{\FP}[1]{\iffpgavariant#1\fi}        % FPGA / SoC CV only
\newcommand{\NF}[1]{\iffpgavariant\else#1\fi}   % every CV except FPGA / SoC

% Group heading for project lists
\newcommand{\cvgroup}[1]{\vspace{4pt}{\headfont\fontsize{9.6pt}{11.6pt}\selectfont\color{muted}#1}\par}

\endinput
